{
  "name": "taskhub",
  "displayName": "TaskHub",
  "description": "%extension.description%",
  "icon": "media/h_icon.png",
  "publisher": "Munseop",
  "version": "0.8.12",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MunseopLim/TaskHub.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%extension.untrustedWorkspaceDescription%"
    }
  },
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:c",
    "onLanguage:cpp"
  ],
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": [
          "/.vscode/actions.json",
          "/media/actions.json",
          "/media/actions_example.json"
        ],
        "url": "./schema/actions.schema.json"
      },
      {
        "fileMatch": [
          "/.vscode/links.json",
          "/media/links_example.json"
        ],
        "url": "./schema/links.schema.json"
      },
      {
        "fileMatch": [
          "/.vscode/favorites.json",
          "/media/favorites_example.json"
        ],
        "url": "./schema/favorites.schema.json"
      },
      {
        "fileMatch": [
          "/.vscode/taskhub_types.json"
        ],
        "url": "./schema/taskhub_types.schema.json"
      }
    ],
    "configuration": {
      "title": "TaskHub",
      "properties": {
        "taskhub.showTaskStatus": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%setting.showTaskStatus%"
        },
        "taskhub.executionNotifications": {
          "type": "string",
          "enum": [
            "followStatus",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "%setting.executionNotifications.followStatus%",
            "%setting.executionNotifications.on%",
            "%setting.executionNotifications.off%"
          ],
          "default": "followStatus",
          "markdownDescription": "%setting.executionNotifications%"
        },
        "taskhub.backgroundCompletion.thresholdSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 86400,
          "markdownDescription": "%setting.backgroundCompletionThreshold%"
        },
        "taskhub.backgroundCompletion.notificationMode": {
          "type": "string",
          "enum": [
            "whenUnfocused",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "%setting.backgroundCompletionMode.whenUnfocused%",
            "%setting.backgroundCompletionMode.always%",
            "%setting.backgroundCompletionMode.never%"
          ],
          "default": "whenUnfocused",
          "markdownDescription": "%setting.backgroundCompletionMode%"
        },
        "taskhub.backgroundCompletion.outcomes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "success",
              "failure",
              "stopped"
            ]
          },
          "default": [
            "success",
            "failure",
            "stopped"
          ],
          "uniqueItems": true,
          "markdownDescription": "%setting.backgroundCompletionOutcomes%"
        },
        "taskhub.pipeline.showVerboseLogs": {
          "type": "boolean",
          "default": false,
          "description": "%setting.showVerboseLogs%"
        },
        "taskhub.runLogs.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%setting.runLogsEnabled%"
        },
        "taskhub.runLogs.maxFiles": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "maximum": 1000,
          "markdownDescription": "%setting.runLogsMaxFiles%"
        },
        "taskhub.runLogs.retentionDays": {
          "type": "integer",
          "default": 30,
          "minimum": 0,
          "maximum": 3650,
          "markdownDescription": "%setting.runLogsRetentionDays%"
        },
        "taskhub.runLogs.maxTotalSizeMb": {
          "type": "integer",
          "default": 100,
          "minimum": 8,
          "maximum": 4096,
          "markdownDescription": "%setting.runLogsMaxTotalSize%"
        },
        "taskhub.pipeline.pythonIoEncoding": {
          "type": "string",
          "default": "utf-8",
          "markdownDescription": "%setting.pythonIoEncoding%"
        },
        "taskhub.pipeline.windowsPowerShellEncoding": {
          "type": "string",
          "enum": [
            "utf8",
            "system"
          ],
          "default": "utf8",
          "description": "%setting.windowsPowerShellEncoding%"
        },
        "taskhub.pipeline.outputCaptureLimitMb": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 1024,
          "markdownDescription": "%setting.outputCaptureLimitMb%"
        },
        "taskhub.pipeline.totalOutputLimitMb": {
          "type": "number",
          "default": 32,
          "minimum": 1,
          "maximum": 4096,
          "markdownDescription": "%setting.totalOutputLimitMb%"
        },
        "taskhub.pipeline.maxParallelTasks": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 32,
          "markdownDescription": "%setting.maxParallelTasks%"
        },
        "taskhub.history.maxItems": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "description": "%setting.historyMaxItems%"
        },
        "taskhub.runAnyAction.recentLimit": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "maximum": 20,
          "markdownDescription": "%setting.recentLimit%"
        },
        "taskhub.history.showPanel": {
          "type": "boolean",
          "default": true,
          "description": "%setting.historyShowPanel%"
        },
        "taskhub.preview.showSourceControlContextMenu": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%setting.showSourceControlContextMenu%"
        },
        "taskhub.builtinActions": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "%setting.builtinActions.auto%",
            "%setting.builtinActions.always%",
            "%setting.builtinActions.never%"
          ],
          "default": "auto",
          "markdownDescription": "%setting.builtinActions%"
        },
        "taskhub.dialog.rememberLastLocation": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%setting.rememberLastLocation%"
        },
        "taskhub.hover.numberBase.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%setting.hoverNumberBase%"
        },
        "taskhub.experimental.bitOperationHover.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%setting.bitOperationHover%"
        },
        "taskhub.preset.selected": {
          "type": "string",
          "default": "none",
          "markdownDescription": "%setting.presetSelected%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mainView",
          "title": "TaskHub",
          "icon": "media/h_icon.svg"
        }
      ]
    },
    "views": {
      "mainView": [
        {
          "id": "mainView.main",
          "name": "%view.actions%",
          "icon": "media/m_icon.svg"
        },
        {
          "id": "mainView.linkWorkspace",
          "name": "%view.links%",
          "icon": "media/l_icon.svg"
        },
        {
          "id": "mainView.favorite",
          "name": "%view.favorites%",
          "icon": "media/f_icon.svg"
        },
        {
          "id": "mainView.history",
          "name": "%view.history%",
          "icon": "media/r_icon.svg",
          "when": "config.taskhub.history.showPanel"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mainView.main",
        "when": "workbenchState == empty",
        "contents": "%welcome.noFolder%"
      },
      {
        "view": "mainView.main",
        "when": "workbenchState != empty && config.taskhub.builtinActions != never",
        "contents": "%welcome.noActions%"
      },
      {
        "view": "mainView.main",
        "when": "workbenchState != empty && config.taskhub.builtinActions == never",
        "contents": "%welcome.noActionsNoExamples%"
      },
      {
        "view": "mainView.linkWorkspace",
        "when": "workbenchState != empty",
        "contents": "%welcome.noLinks%"
      },
      {
        "view": "mainView.favorite",
        "when": "workbenchState != empty",
        "contents": "%welcome.noFavorites%"
      }
    ],
    "commands": [
      {
        "command": "taskhub.openLink",
        "title": "%cmd.openLink%"
      },
      {
        "command": "taskhub.copyLink",
        "title": "%cmd.copyLink%",
        "icon": "$(copy)"
      },
      {
        "command": "taskhub.goToLink",
        "title": "%cmd.goToLink%"
      },
      {
        "command": "taskhub.addLink",
        "title": "%cmd.addLink%",
        "icon": "$(add)"
      },
      {
        "command": "taskhub.editWorkspaceLink",
        "title": "%cmd.editWorkspaceLink%",
        "icon": "$(pencil)"
      },
      {
        "command": "taskhub.searchLinks",
        "title": "%cmd.searchLinks%",
        "icon": "$(search)"
      },
      {
        "command": "taskhub.searchFavorites",
        "title": "%cmd.searchFavorites%",
        "icon": "$(search)"
      },
      {
        "command": "taskhub.createAction",
        "title": "%cmd.createAction%",
        "icon": "$(add)"
      },
      {
        "command": "taskhub.executeAction",
        "title": "%cmd.executeAction%"
      },
      {
        "command": "taskhub.previewAction",
        "title": "%cmd.previewAction%",
        "category": "TaskHub",
        "icon": "$(eye)"
      },
      {
        "command": "taskhub.doctor",
        "title": "%cmd.doctor%",
        "category": "TaskHub",
        "icon": "$(checklist)"
      },
      {
        "command": "taskhub.clearQuickPickSelections",
        "title": "%cmd.clearQuickPickSelections%",
        "category": "TaskHub",
        "icon": "$(clear-all)"
      },
      {
        "command": "taskhub.stopAction",
        "title": "%cmd.stopAction%",
        "icon": "$(primitive-square)"
      },
      {
        "command": "taskhub.showVersion",
        "title": "%cmd.showVersion%"
      },
      {
        "command": "taskhub.openFavoriteFile",
        "title": "%cmd.openFavoriteFile%"
      },
      {
        "command": "taskhub.editFavorites",
        "title": "%cmd.editFavorites%",
        "icon": "$(pencil)"
      },
      {
        "command": "taskhub.editLinks",
        "title": "%cmd.editLinks%",
        "icon": "$(pencil)"
      },
      {
        "command": "taskhub.editActions",
        "title": "%cmd.editActions%",
        "icon": "$(pencil)"
      },
      {
        "command": "taskhub.addFavoriteFile",
        "title": "%cmd.addFavoriteFile%",
        "icon": "$(add)"
      },
      {
        "command": "taskhub.deleteFavorite",
        "title": "%cmd.deleteFavorite%",
        "icon": "$(trash)"
      },
      {
        "command": "taskhub.deleteLink",
        "title": "%cmd.deleteLink%",
        "icon": "$(trash)"
      },
      {
        "command": "taskhub.addOpenFileToFavorites",
        "title": "%cmd.addOpenFileToFavorites%",
        "icon": "$(add)"
      },
      {
        "command": "taskhub.showExampleJson",
        "title": "%cmd.showExampleJson%"
      },
      {
        "command": "taskhub.showExampleJsonQuickPick",
        "title": "%cmd.showExampleJsonQuickPick%",
        "icon": "$(lightbulb)"
      },
      {
        "command": "taskhub.showChangelog",
        "title": "%cmd.showChangelog%"
      },
      {
        "command": "taskhub.stopAllActions",
        "title": "%cmd.stopAllActions%",
        "icon": "$(primitive-square)"
      },
      {
        "command": "taskhub.closeAllTerminals",
        "title": "%cmd.closeAllTerminals%",
        "icon": "$(terminal)"
      },
      {
        "command": "taskhub.terminateAllActions",
        "title": "%cmd.terminateAllActions%",
        "icon": "$(primitive-square)"
      },
      {
        "command": "taskhub.openSettings",
        "title": "%cmd.openSettings%"
      },
      {
        "command": "taskhub.openRunLogsFolder",
        "title": "%cmd.openRunLogsFolder%"
      },
      {
        "command": "taskhub.viewActionRunReport",
        "title": "%cmd.viewActionRunReport%",
        "icon": "$(preview)"
      },
      {
        "command": "taskhub.rerunFromHistory",
        "title": "%cmd.rerunFromHistory%",
        "icon": "$(refresh)"
      },
      {
        "command": "taskhub.rerunFromHistoryWithInputs",
        "title": "%cmd.rerunFromHistoryWithInputs%",
        "icon": "$(run-all)"
      },
      {
        "command": "taskhub.runActionWithInputProfile",
        "title": "%cmd.runActionWithInputProfile%"
      },
      {
        "command": "taskhub.manageInputProfiles",
        "title": "%cmd.manageInputProfiles%"
      },
      {
        "command": "taskhub.manageAllInputProfiles",
        "title": "%cmd.manageAllInputProfiles%"
      },
      {
        "command": "taskhub.saveHistoryInputsAsProfile",
        "title": "%cmd.saveHistoryInputsAsProfile%"
      },
      {
        "command": "taskhub.viewHistoryOutput",
        "title": "%cmd.viewHistoryOutput%",
        "icon": "$(output)"
      },
      {
        "command": "taskhub.viewHistoryCommand",
        "title": "%cmd.viewHistoryCommand%",
        "icon": "$(terminal)"
      },
      {
        "command": "taskhub.deleteHistoryItem",
        "title": "%cmd.deleteHistoryItem%",
        "icon": "$(trash)"
      },
      {
        "command": "taskhub.clearAllHistory",
        "title": "%cmd.clearAllHistory%",
        "icon": "$(clear-all)"
      },
      {
        "command": "taskhub.toggleHistoryPanel",
        "title": "%cmd.toggleHistoryPanel%"
      },
      {
        "command": "taskhub.applyPreset",
        "title": "%cmd.applyPreset%"
      },
      {
        "command": "taskhub.saveAsPreset",
        "title": "%cmd.saveAsPreset%"
      },
      {
        "command": "taskhub.openJsonEditor",
        "title": "%cmd.openJsonEditor%",
        "icon": "$(edit)"
      },
      {
        "command": "taskhub.openJsonEditorFromUri",
        "title": "%cmd.openJsonEditorFromUri%",
        "category": "TaskHub"
      },
      {
        "command": "taskhub.showMemoryMap",
        "title": "%cmd.showMemoryMap%",
        "category": "TaskHub"
      },
      {
        "command": "taskhub.openMemoryMapFromUri",
        "title": "%cmd.openMemoryMapFromUri%",
        "category": "TaskHub"
      },
      {
        "command": "taskhub.memoryMapGoToSymbol",
        "title": "%cmd.memoryMapGoToSymbol%",
        "category": "TaskHub"
      },
      {
        "command": "taskhub.revealSymbolInMemoryMap",
        "title": "%cmd.revealSymbolInMemoryMap%",
        "category": "TaskHub"
      },
      {
        "command": "taskhub.exportActions",
        "title": "%cmd.exportActions%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "taskhub.importActions",
        "title": "%cmd.importActions%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "taskhub.exportActionItem",
        "title": "%cmd.exportActionItem%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "taskhub.assignShortcut",
        "title": "%cmd.assignShortcut%",
        "category": "TaskHub"
      },
      {
        "command": "taskhub.runAnyAction",
        "title": "%cmd.runAnyAction%",
        "icon": "$(search)"
      },
      {
        "command": "taskhub.showFeatureLauncher",
        "title": "%cmd.showFeatureLauncher%",
        "category": "TaskHub"
      },
      {
        "command": "taskhub.showHexViewer",
        "title": "%cmd.showHexViewer%",
        "category": "TaskHub"
      },
      {
        "command": "taskhub.showHexConverter",
        "title": "%cmd.showHexConverter%",
        "category": "TaskHub"
      },
      {
        "command": "taskhub.openMarkdownPreview",
        "title": "%cmd.openMarkdownPreview%",
        "category": "TaskHub"
      },
      {
        "command": "taskhub.openHtmlInBrowser",
        "title": "%cmd.openHtmlInBrowser%",
        "category": "TaskHub"
      }
    ],
    "keybindings": [
      {
        "command": "taskhub.memoryMapGoToSymbol",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeWebviewPanelId == 'taskhub.memoryMap'"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "taskhub.openMemoryMapFromUri",
          "when": "false"
        },
        {
          "command": "taskhub.terminateAllActions",
          "when": "false"
        },
        {
          "command": "taskhub.openLink",
          "when": "false"
        },
        {
          "command": "taskhub.copyLink",
          "when": "false"
        },
        {
          "command": "taskhub.goToLink",
          "when": "false"
        },
        {
          "command": "taskhub.executeAction",
          "when": "false"
        },
        {
          "command": "taskhub.previewAction",
          "when": "false"
        },
        {
          "command": "taskhub.stopAction",
          "when": "false"
        },
        {
          "command": "taskhub.editWorkspaceLink",
          "when": "false"
        },
        {
          "command": "taskhub.deleteFavorite",
          "when": "false"
        },
        {
          "command": "taskhub.deleteLink",
          "when": "false"
        },
        {
          "command": "taskhub.openFavoriteFile",
          "when": "false"
        },
        {
          "command": "taskhub.rerunFromHistory",
          "when": "false"
        },
        {
          "command": "taskhub.viewActionRunReport",
          "when": "false"
        },
        {
          "command": "taskhub.rerunFromHistoryWithInputs",
          "when": "false"
        },
        {
          "command": "taskhub.runActionWithInputProfile",
          "when": "false"
        },
        {
          "command": "taskhub.manageInputProfiles",
          "when": "false"
        },
        {
          "command": "taskhub.saveHistoryInputsAsProfile",
          "when": "false"
        },
        {
          "command": "taskhub.viewHistoryOutput",
          "when": "false"
        },
        {
          "command": "taskhub.viewHistoryCommand",
          "when": "false"
        },
        {
          "command": "taskhub.deleteHistoryItem",
          "when": "false"
        },
        {
          "command": "taskhub.exportActionItem",
          "when": "false"
        },
        {
          "command": "taskhub.assignShortcut",
          "when": "false"
        },
        {
          "command": "taskhub.showExampleJson",
          "when": "false"
        },
        {
          "command": "taskhub.memoryMapGoToSymbol",
          "when": "activeWebviewPanelId == 'taskhub.memoryMap'"
        }
      ],
      "view/title": [
        {
          "command": "taskhub.searchFavorites",
          "when": "view == mainView.favorite",
          "group": "navigation@1"
        },
        {
          "command": "taskhub.addFavoriteFile",
          "when": "view == mainView.favorite",
          "group": "navigation@2"
        },
        {
          "command": "taskhub.editFavorites",
          "when": "view == mainView.favorite",
          "group": "navigation@3"
        },
        {
          "command": "taskhub.searchLinks",
          "when": "view == mainView.linkWorkspace",
          "group": "navigation@1"
        },
        {
          "command": "taskhub.addLink",
          "when": "view == mainView.linkWorkspace",
          "group": "navigation@2"
        },
        {
          "command": "taskhub.editLinks",
          "when": "view == mainView.linkWorkspace",
          "group": "navigation@3"
        },
        {
          "command": "taskhub.runAnyAction",
          "when": "view == mainView.main",
          "group": "navigation@1"
        },
        {
          "command": "taskhub.createAction",
          "when": "view == mainView.main",
          "group": "navigation@2"
        },
        {
          "command": "taskhub.editActions",
          "when": "view == mainView.main",
          "group": "9_taskhub@0"
        },
        {
          "command": "taskhub.stopAllActions",
          "when": "view == mainView.main && taskhub.hasRunningActions",
          "group": "navigation@3"
        },
        {
          "command": "taskhub.showExampleJsonQuickPick",
          "when": "view == mainView.main",
          "group": "9_taskhub@1"
        },
        {
          "command": "taskhub.importActions",
          "when": "view == mainView.main",
          "group": "9_taskhub@2"
        },
        {
          "command": "taskhub.exportActions",
          "when": "view == mainView.main",
          "group": "9_taskhub@3"
        },
        {
          "command": "taskhub.closeAllTerminals",
          "when": "view == mainView.main",
          "group": "9_taskhub@4"
        },
        {
          "command": "taskhub.showChangelog",
          "when": "view == mainView.main",
          "group": "9_taskhub@5"
        },
        {
          "command": "taskhub.clearAllHistory",
          "when": "view == mainView.history",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "taskhub.addOpenFileToFavorites",
          "group": "navigation"
        },
        {
          "command": "taskhub.openJsonEditorFromUri",
          "when": "resourceExtname == .json",
          "group": "navigation"
        },
        {
          "command": "taskhub.revealSymbolInMemoryMap",
          "when": "editorLangId == c || editorLangId == cpp",
          "group": "1_taskhub"
        }
      ],
      "explorer/context": [
        {
          "command": "taskhub.openJsonEditorFromUri",
          "when": "resourceExtname == .json",
          "group": "navigation"
        },
        {
          "command": "taskhub.openMemoryMapFromUri",
          "when": "resourceFilename =~ /\\.(elf|axf|out)$/i",
          "group": "navigation@10"
        },
        {
          "command": "taskhub.openMarkdownPreview",
          "when": "resourceFilename =~ /\\.(md|markdown)$/i",
          "group": "navigation@10"
        },
        {
          "command": "taskhub.openHtmlInBrowser",
          "when": "resourceFilename =~ /\\.(html|htm)$/i",
          "group": "navigation@10"
        }
      ],
      "editor/title/context": [
        {
          "command": "taskhub.openMarkdownPreview",
          "when": "resourceFilename =~ /\\.(md|markdown)$/i",
          "group": "navigation@10"
        },
        {
          "command": "taskhub.openHtmlInBrowser",
          "when": "resourceFilename =~ /\\.(html|htm)$/i",
          "group": "navigation@10"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "taskhub.openJsonEditorFromUri",
          "when": "resourceExtname == .json",
          "group": "navigation"
        },
        {
          "command": "taskhub.openMarkdownPreview",
          "when": "config.taskhub.preview.showSourceControlContextMenu",
          "group": "navigation@10"
        },
        {
          "command": "taskhub.openHtmlInBrowser",
          "when": "config.taskhub.preview.showSourceControlContextMenu",
          "group": "navigation@10"
        }
      ],
      "view/item/context": [
        {
          "command": "taskhub.copyLink",
          "when": "view == mainView.linkWorkspace && viewItem == linkItem",
          "group": "inline"
        },
        {
          "command": "taskhub.goToLink",
          "when": "view == mainView.linkWorkspace && viewItem == linkItem",
          "group": "context@0"
        },
        {
          "command": "taskhub.copyLink",
          "when": "view == mainView.linkWorkspace && viewItem == linkItem",
          "group": "context@1"
        },
        {
          "command": "taskhub.editWorkspaceLink",
          "when": "view == mainView.linkWorkspace && viewItem == linkItem",
          "group": "context@2"
        },
        {
          "command": "taskhub.deleteLink",
          "when": "view == mainView.linkWorkspace && viewItem == linkItem",
          "group": "context@9"
        },
        {
          "command": "taskhub.deleteFavorite",
          "when": "view == mainView.favorite && viewItem == favoriteItem",
          "group": "context@9"
        },
        {
          "command": "taskhub.previewAction",
          "when": "view == mainView.main && viewItem =~ /^(action|runningAction|succeededAction|failedAction)$/",
          "group": "context@1"
        },
        {
          "command": "taskhub.exportActionItem",
          "when": "view == mainView.main && viewItem =~ /^(action|runningAction|succeededAction|failedAction)$/",
          "group": "context@2"
        },
        {
          "command": "taskhub.exportActionItem",
          "when": "view == mainView.main && viewItem == folder",
          "group": "context@2"
        },
        {
          "command": "taskhub.assignShortcut",
          "when": "view == mainView.main && viewItem =~ /^(action|runningAction|succeededAction|failedAction)$/",
          "group": "context@3"
        },
        {
          "command": "taskhub.runActionWithInputProfile",
          "when": "view == mainView.main && viewItem =~ /^(action|runningAction|succeededAction|failedAction)$/",
          "group": "context@4"
        },
        {
          "command": "taskhub.manageInputProfiles",
          "when": "view == mainView.main && viewItem =~ /^(action|runningAction|succeededAction|failedAction)$/",
          "group": "context@5"
        },
        {
          "command": "taskhub.stopAction",
          "when": "view == mainView.main && viewItem == runningAction",
          "group": "inline"
        },
        {
          "command": "taskhub.stopAction",
          "when": "view == mainView.main && viewItem == runningAction",
          "group": "context@0"
        },
        {
          "command": "taskhub.rerunFromHistory",
          "when": "view == mainView.history && viewItem =~ /^historyItem/",
          "group": "inline@0"
        },
        {
          "command": "taskhub.rerunFromHistory",
          "when": "view == mainView.history && viewItem =~ /^historyItem/",
          "group": "context@0"
        },
        {
          "command": "taskhub.rerunFromHistoryWithInputs",
          "when": "view == mainView.history && viewItem =~ /\\.inputs\\b/",
          "group": "context@1"
        },
        {
          "command": "taskhub.saveHistoryInputsAsProfile",
          "when": "view == mainView.history && viewItem =~ /\\.inputs\\b/",
          "group": "context@2"
        },
        {
          "command": "taskhub.viewHistoryCommand",
          "when": "view == mainView.history && viewItem =~ /\\.commands\\b/",
          "group": "context@4"
        },
        {
          "command": "taskhub.viewHistoryOutput",
          "when": "view == mainView.history && viewItem =~ /\\.output\\b/",
          "group": "context@5"
        },
        {
          "command": "taskhub.viewActionRunReport",
          "when": "view == mainView.history && viewItem =~ /^historyItem/",
          "group": "context@3"
        },
        {
          "command": "taskhub.deleteHistoryItem",
          "when": "view == mainView.history && viewItem =~ /^(historyItem|historyToolItem)/",
          "group": "context@9"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "taskhub.hexEditor",
        "displayName": "%customEditor.hexViewer%",
        "selector": [
          {
            "filenamePattern": "*.hex"
          },
          {
            "filenamePattern": "*.ihex"
          },
          {
            "filenamePattern": "*.srec"
          },
          {
            "filenamePattern": "*.s19"
          },
          {
            "filenamePattern": "*.s28"
          },
          {
            "filenamePattern": "*.s37"
          },
          {
            "filenamePattern": "*.bin"
          },
          {
            "filenamePattern": "*.dat"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "npm run clean-tests && tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "clean-tests": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\""
  },
